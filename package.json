{
  "name": "fiq-finance-manager",
  "version": "1.1.2",
  "description": "Personal finance management",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder --win --x64",
    "build:portable": "electron-builder --win portable --x64",
    "build:installer": "electron-builder --win nsis --x64",
    "dist": "electron-builder"
  },
  "keywords": [
    "finance",
    "expense-tracker",
    "mysql",
    "electron"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.fiq.finance-manager",
    "productName": "Shwet",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false,
      "sign": null
    },
    "portable": {
      "artifactName": "Shwet.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Shwet-Setup.exe",
      "deleteAppDataOnUninstall": false
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "js/**/*",
      "styles/**/*",
      "assets/**/*",
      "!assets/README.md",
      "node_modules/**/*",
      "!node_modules/**/test/**/*",
      "!node_modules/**/tests/**/*",
      "!node_modules/**/*.md"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": ["**/*"]
      }
    ]
  },
  "dependencies": {
    "mysql2": "^3.15.3"
  },
  "devDependencies": {
    "electron": "^39.1.1",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  }
}
